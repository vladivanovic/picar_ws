# PiCar bringup as a systemd service (Raspberry Pi).
# Install:
#   sudo cp systemd/picar.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now picar
# Adjust User= and the workspace path if yours differ.
# Logs: journalctl -u picar -f
[Unit]
Description=PiCar ROS 2 bringup (lidar, motors, odometry, Wi-Fi RSSI)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=vlad
WorkingDirectory=/home/vlad/picar_ws
Environment=ROS_DOMAIN_ID=42
# RMW choice must match the Orin side. Cyclone DDS is a good fit for a
# 1 GB Pi; leave unset to use the Jazzy default (Fast DDS).
#Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ExecStart=/home/vlad/picar_ws/start_picar_pi.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
